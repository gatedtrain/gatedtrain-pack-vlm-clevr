# The pack's trainer image for a rootless Docker host: gatedtrain's pinned Tier B NeMo RL image
# (sha256:8cd5b714ea91ec7ea9a976c75b0ae6f6932140cf7a8aea803100de6331a2113a, tagged nemo-rl:4f39fd8 locally) with the vLLM
# files NeMo RL patches at start-up (nemo_rl/models/generation/vllm/patches.py) owned by root. NeMo RL rewrites those
# files and creates `<file>.patch_lock` beside them in the VllmGenerationWorker venv, which belongs to nemo-runtime
# (uid 65532) in the Tier B image. Under rootless Docker the container's root is the owner, and the training container
# drops every capability (no DAC_OVERRIDE), so only a file owned by uid 0 can be written: without this layer the first
# GRPO step fails with PermissionError on ray_executor.py.patch_lock. The same ten files and eight directories as
# gatedtrain's containers/nemo-rl-uid1000 change owner (to 0:0 here, to 1000:1000 there); nothing is added or upgraded.
# Build, on the owner's rootless daemon (no network needed):
#   docker --context <ctx> tag sha256:8cd5b714ea91ec7ea9a976c75b0ae6f6932140cf7a8aea803100de6331a2113a nemo-rl:4f39fd8
#   docker --context <ctx> build -t gatedtrain-pack-vlm-clevr-nemo-rl:1 -f Containerfile .
# The image ID is host specific; list it in GATEDTRAIN_PACK_VLM_CLEVR_EXTRA_IMAGES and use it as the `image` of smoke
# and train. It is not the image ID gatedtrain pins (NEMO_RL_IMAGES): that is a deliberate, documented difference.
FROM nemo-rl:4f39fd8
USER root
RUN set -eu; \
    V=/opt/ray_venvs/nemo_rl.models.generation.vllm.vllm_worker.VllmGenerationWorker/lib/python3.13/site-packages/vllm; \
    for f in distributed/device_communicators/shm_broadcast.py \
             model_executor/layers/fused_moe/routed_experts_capturer.py \
             model_executor/layers/fused_moe/runner/moe_runner.py \
             model_executor/models/deepseek_v2.py \
             model_executor/models/llama_eagle3.py \
             model_executor/models/nano_nemotron_vl.py \
             model_executor/models/radio.py \
             tool_parsers/utils.py \
             v1/executor/ray_executor.py \
             v1/executor/ray_executor_v2.py; do \
      test -f "$V/$f"; chown 0:0 "$V/$f" "$(dirname "$V/$f")"; \
    done
USER root
